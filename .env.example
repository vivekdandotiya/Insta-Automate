# Application Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
TIMEZONE=Asia/Kolkata

# Database URL (SQLite by default, PostgreSQL ready)
DATABASE_URL="file:./dev.db"

# Agent & Monitoring Configuration
CHECK_INTERVAL_SECONDS=300
MIN_RELEVANCE_SCORE=MEDIUM

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Classifier Credentials (Optional - Fallback Keyword Engine is active if unconfigured)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# OCR Feature Flag
OCR_ENABLED=true

# Instagram Access Mode Choices:
# 1) apify    - Recommended for public accounts (Requires APIFY_API_TOKEN)
# 2) rapidapi - RapidAPI Instagram endpoints (Requires RAPIDAPI_KEY)
# 3) graph_api - Meta Graph API for Business/Creator accounts (Requires INSTAGRAM_GRAPH_API_TOKEN)
# 4) scraper  - Custom Scraping Gateway (Requires INSTAGRAM_SCRAPER_GATEWAY)
# 5) mock     - Local demo mode with static realistic posts
INSTAGRAM_ADAPTER_MODE=apify

# Option 1: Apify Configuration (Recommended for public account monitoring)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify~instagram-scraper

# Option 2: RapidAPI Configuration
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-bulk-scraper-latest.p.rapidapi.com

# Option 3: Meta Graph API Configuration
INSTAGRAM_GRAPH_API_TOKEN=

# Option 4: Custom Scraper Gateway Configuration
INSTAGRAM_SCRAPER_GATEWAY=
