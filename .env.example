# Application Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
TIMEZONE=Asia/Kolkata

# PostgreSQL Database URL (Supabase / Neon / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Agent & Monitoring Configuration
CHECK_INTERVAL_SECONDS=300
POLL_INTERVAL_HOURS=2
MIN_RELEVANCE_SCORE=MEDIUM

# Telegram Bot Credentials (REQUIRED FOR ALERTS)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Classifier Credentials (OPTIONAL)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# OCR Feature Flag
OCR_ENABLED=true

# Instagram Access Mode Choices: apify | rapidapi | graph_api | scraper | mock
INSTAGRAM_ADAPTER_MODE=apify

# Apify Configuration
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify~instagram-scraper

# RapidAPI Configuration
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-bulk-scraper-latest.p.rapidapi.com

# Meta Graph API Configuration
INSTAGRAM_GRAPH_API_TOKEN=

# Custom Scraper Gateway Configuration
INSTAGRAM_SCRAPER_GATEWAY=
