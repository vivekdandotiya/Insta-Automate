{
  "name": "instagram-job-alert-agent",
  "version": "1.0.0",
  "description": "Autonomous Instagram Job Alert Agent with AI classification, timestamp filtering, deduplication, and Telegram notifications",
  "main": "dist/src/index.js",
  "scripts": {
    "init:db": "prisma generate && prisma db push",
    "build:backend": "tsc -p tsconfig.json",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "node dist/src/index.js",
    "dev:backend": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:instagram": "tsc -p tsconfig.json && node dist/scripts/test-instagram.js",
    "run-cycle": "tsc -p tsconfig.json && node dist/scripts/run-cycle.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "date-fns-tz": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "tesseract.js": "^5.0.4",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
